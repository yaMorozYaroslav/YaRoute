{
  "name": "nestnyx",
  "version": "0.6.0",
  "private": true,
  "description": "Nyx storage execution API and MCP server for shared-folder-scoped rclone operations",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "nest build && node scripts/build-info.mjs",
    "security:check": "node scripts/public-repo-guard.mjs",
    "postinstall": "node scripts/install-rclone.mjs",
    "heroku-postbuild": "npm run build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "adm-zip": "^0.6.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.1",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2"
  }
}
